{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "A product available for sale",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "description": { "type": "string", "maxLength": 1000 },
        "price": { "type": "number", "minimum": 0 },
        "categoryId": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$" },
        "imageUrl": { "type": "string" },
        "isAvailable": { "type": "boolean" },
        "isPopular": { "type": "boolean" },
        "isSpecial": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "price", "categoryId", "imageUrl", "isAvailable", "isPopular", "isSpecial", "createdAt", "updatedAt"]
    },
    "Category": {
      "title": "Category",
      "description": "Product category",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 50 }
      },
      "required": ["name"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer order",
      "type": "object",
      "properties": {
        "customerName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "customerPhone": { "type": "string", "minLength": 10, "maxLength": 15 },
        "customerAddress": { "type": "string", "minLength": 5 },
        "items": { "type": "array" },
        "totalAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["New", "Confirmed", "Preparing", "Out for Delivery", "Delivered", "Cancelled"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["customerName", "customerPhone", "customerAddress", "items", "totalAmount", "status", "createdAt"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Admin user whitelist",
      "type": "object",
      "properties": {
        "email": { "type": "string" }
      },
      "required": ["email"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Collection of products"
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Collection of categories"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Collection of customer orders"
    },
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "Whitelist of admin UIDs"
    }
  }
}
